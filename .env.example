NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_KEY=
DESIGN_SYSTEM_PASSWORD=

# Email Octopus — homepage newsletter signup (/api/newsletter/subscribe)
EMAILOCTOPUS_API_KEY=
EMAILOCTOPUS_NEWSLETTER_LIST_ID=
# Optional tag on subscribe (default: newsletter) — use in EO automations
EMAILOCTOPUS_NEWSLETTER_TAG=newsletter
# Enable signup locally without flipping site-features (set true in .env.local only)
NEXT_PUBLIC_NEWSLETTER_SIGNUP_ENABLED=

# Email Octopus — book page “Download free chapter” (/api/book/free-chapter)
EMAILOCTOPUS_FREE_CHAPTER_LIST_ID=
# Optional tag applied on signup (default: free-chapter) — use in automation triggers
EMAILOCTOPUS_FREE_CHAPTER_TAG=

# Playbooks — first click gates email; link sent via Email Octopus automation
# Uses PLAYBOOKS list if set, otherwise FREE_CHAPTER list
EMAILOCTOPUS_PLAYBOOKS_LIST_ID=
EMAILOCTOPUS_PLAYBOOKS_TAG=playbook

# Notion CRM (🤝 CRM database) — tags each playbook click in Log/Notes
NOTION_API_KEY=
NOTION_CRM_DATABASE_ID=c5441716-da28-8203-93c1-9812a85364740

# Public site URL used in playbook emails (optional; defaults to thequietachievr.com)
NEXT_PUBLIC_SITE_URL=
SITE_URL=https://websitetqa.thequietachievr.com

# Ghost newsletter (weekly signup + opt-out sync)
GHOST_URL=
GHOST_ADMIN_API_KEY=

# Signed unsubscribe links + n8n drip template personalization
NEWSLETTER_ADMIN_SECRET=
NEWSLETTER_UNSUBSCRIBE_SECRET=
